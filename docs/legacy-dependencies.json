    "src/routeTree.gen.ts",
    "src/test/demo-mode.test.tsx",
    "src/test/public-registration.test.ts"
  ],
  "replacementPlan": {
    "transport-facade": "Replace src/lib/php-api.ts and src/lib/php-connection.ts with the new typed /api/v3 client (generated from the API repository's OpenAPI contract). Keep the rejecting facade until the client exists.",
    "legacy-endpoint-call": "Map each call's old operation name (session, login, logout, own, screen, workflow, activate, recover, reset-password, downloads, uploads) to the reviewed /api/v3 resource. Do not reuse the old endpoint shapes.",
    "legacy-session-dto": "Replace PhpAccess and phpCan with the V3 session/capability types from the API contract (four roles; capabilities supplied by the backend).",
    "legacy-query-key": "Rename React Query keys to the V3 client's resource keys.",
    "connection-selector": "Replace usePhpIntegration-based routing with the V3 client's session state; demo screens remain gated by demoModeAllowed().",
    "php-prefixed-component": "Rewire or rename Php*-prefixed screens to the V3 client while preserving their layout and behaviour.",
    "retired-login-destination": "ADMIN_LOGIN_URL is fixed to null (V3 retired the external login URL). Remove it when the V3 sign-in flow is integrated.",
    "facade-import": "Imports of the retired facade modules; they change automatically when the modules above are replaced."
  },
